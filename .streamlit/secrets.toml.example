# Copy this file to .streamlit/secrets.toml for local development,
# or paste its contents into the "Secrets" box in the Streamlit Community
# Cloud app settings for deployment. Do NOT commit a real secrets.toml.

# Supabase Postgres connection string.
# In Supabase: Project Settings > Database > Connection string > URI
# (use the "Session pooler" host/port for Streamlit Cloud).
# Rewrite the scheme from postgresql:// to postgresql+psycopg2:// as shown.
DATABASE_URL = "postgresql+psycopg2://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"

# Named users with simple role-based access.
# Roles: Company Admin, technical, viewer
[users.admin]
password = "changeme"
display_name = "Stefan Hermes"
role = "Company Admin"

[users.tech1]
password = "changeme2"
display_name = "Technical User"
role = "technical"

[users.viewer1]
password = "changeme3"
display_name = "Viewer"
role = "viewer"

# PI3 connectivity (optional add-on - see the PI3 Connectivity admin
# screen). Only needed on plants where the toggle there is turned on.
# Create a vector store yourself in the OpenAI dashboard/API first, then
# paste its ID below. Uses the Responses API (not the retired Assistants
# API), so no separate Assistant object is needed - the system prompt
# lives in ai_assistant.py instead.
OPENAI_API_KEY = "sk-..."
PI3_VECTOR_STORE_ID = "vs_..."
# Optional - defaults to ai_assistant.DEFAULT_MODEL if unset.
# PI3_MODEL = "gpt-5.6-terra"

# Development-only login bypass. With this set, the app never asks anyone to
# log in and every visitor gets full platform-owner rights - so it belongs on
# a development or UAT deployment only, never on one holding real customer
# data.
# AUTH_DISABLED = true

# Who is at the keyboard while AUTH_DISABLED is on. The audit trail records
# this name against every PI3 interaction and every verification decision, so
# development records say who did the work instead of a generic "Dev".
# The application always appends "(auth disabled)" to it: a session with no
# account behind it identifies but does not authenticate, and an audit record
# must not read like a signed-in user when nobody signed in.
# DEV_USER_DISPLAY_NAME = "Stefan Hermes"
